# ============================================================
# AI Hunter — .gitignore
# ============================================================

# ── Secrets / Environment ────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.venv_build/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
.eggs/
MANIFEST

# PyInstaller
*.spec.bak
build/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# ruff / linters
.ruff_cache/

# ── Runtime data (user-generated, not source) ────────────────
data/
uploads/
template_seed_cache.json
*.db
*.sqlite
*.sqlite3

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE / Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# Legacy sqlite shell (real data lives in PostgreSQL); never commit
email_automation.db
